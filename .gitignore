# macOS metadata
.DS_Store
._*
.Spotlight-V100
.Trashes

# vitaGL vendorizada: el Makefile SÍ se versiona; artefactos de build no.
# OJO: estas excepciones van PRIMERAS porque `rsync --filter=":- .gitignore"`
# (usado por psvita-toolkit para compilar rutas con espacios) aplica la
# primera coincidencia, no la última como git.
!/vendor/vitaGL/Makefile
/vendor/vitaGL/**/*.o
/vendor/vitaGL/libvitaGL.a

# Android APK/ZIP originales y extracción -- nunca commitear el juego (DMCA)
*.apk
*.zip
/ragingthunder_extract/

# Java decompilado con jadx (derivado, regenerable: jadx -d decompiled/apk_jadx "raging-thunder-free-1-2-1.apk")
/decompiled/apk_jadx/

# Pseudo-C decompilado del/los .so (derivado, regenerable con devrvk/so-decompiler)
/decompiled/*/ghidra/

# Librerías .so propietarias del juego original
lib/*.so
lib/**/*.so
ragingthunder_extract/lib/

# Assets del juego montados para pruebas
ux0_data/
assets/

# Build artifacts
/build/
/Makefile
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.elf
*.self
*.vpk
*.suprx

# Debugging en consola real
/logs/
log_*.txt
*_???.log
*.psp2dmp

# Python
__pycache__/
*.pyc

# Config local del toolkit (contiene IP de tu Vita -- no es secreto pero es de tu red)
.psvita-toolkit.json

# Solo desarrollo local (no se distribuye)
.claude/
compile_commands.json

# Arte fuente de LiveArea y backups locales
*.bak
/81DuhC0ebCL*.png

# IDE
.vscode/
.idea/
*.swp
cmake-build-*/
